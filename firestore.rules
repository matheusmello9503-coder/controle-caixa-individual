rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function souAdmin() {
      return estaLogado()
        && meuUsuario().perfil == 'admin'
        && meuUsuario().ativo == true;
    }

    function souSupervisorAtivo() {
      return estaLogado()
        && meuUsuario().perfil == 'supervisor'
        && meuUsuario().ativo == true;
    }

    // Admin e Supervisor podem ver o fechamento consolidado (todos os
    // lancamentos do dia, nao so os proprios).
    function souGerencial() {
      return souAdmin() || souSupervisorAtivo();
    }

    function souRecepcaoAtivo() {
      return estaLogado()
        && meuUsuario().perfil == 'recepcao'
        && meuUsuario().ativo == true;
    }

    // Campo Grande (MS) fica em UTC-4 o ano todo (nao usa horario de verao).
    // Este calculo usa o relogio do PROPRIO SERVIDOR do Firebase
    // (request.time), entao nao pode ser burlado mudando o relogio do
    // computador ou celular de quem esta usando o sistema.
    function dentroDoHorarioPermitido() {
      let deslocamentoMillis = 4 * 60 * 60 * 1000;
      let localMillis = request.time.toMillis() - deslocamentoMillis;
      let horaLocal = (localMillis / 3600000) % 24;
      return horaLocal >= 7 && horaLocal < 19;
    }

    // Data local (Campo Grande, UTC-4) de agora, como numero de dias
    // inteiros desde a epoca - usado para comparar com a data (tambem em
    // dias) de quando um lancamento foi criado, sem depender de "quantas
    // horas se passaram" (que varia dependendo da hora do dia).
    function diaLocalDeHoje() {
      let deslocamentoMillis = 4 * 60 * 60 * 1000;
      let localMillis = request.time.toMillis() - deslocamentoMillis;
      return localMillis / (24 * 60 * 60 * 1000);
    }
    function diaLocalDoMomento(momento) {
      let deslocamentoMillis = 4 * 60 * 60 * 1000;
      let localMillis = momento.toMillis() - deslocamentoMillis;
      return localMillis / (24 * 60 * 60 * 1000);
    }

    // ---------- usuarios ----------
    // Cada pessoa pode ler o proprio cadastro (para o sistema saber seu
    // perfil). O administrador pode ler, criar, editar e desativar qualquer
    // cadastro. O supervisor pode ler a lista de usuarios (para saber quem
    // e quem nos relatorios), mas nao pode criar, editar nem desativar
    // ninguem - isso e exclusivo do administrador, o que impede alguem de
    // se autopromover.
    match /usuarios/{usuarioId} {
      allow read: if estaLogado() && (request.auth.uid == usuarioId || souAdmin() || souSupervisorAtivo());
      allow create, update, delete: if souAdmin();
    }

    // ---------- lancamentos (atendimentos) ----------
    match /lancamentos/{lancamentoId} {

      // Leitura: admin e supervisor veem tudo (fechamento consolidado); a
      // recepcao so ve os proprios lancamentos (a consulta feita pelo
      // aplicativo ja filtra por usuarioId, e esta regra garante que
      // ninguem consiga ler o lancamento de outra pessoa mesmo tentando
      // burlar o aplicativo).
      allow read: if souGerencial()
        || (souRecepcaoAtivo() && resource.data.usuarioId == request.auth.uid);

      // Criacao: precisa estar logado, o lancamento tem que ser gravado em
      // nome de quem esta logado, os campos essenciais precisam ser
      // validos, e a recepcao so pode lancar dentro do horario permitido
      // (admin e supervisor nao tem essa restricao).
      allow create: if estaLogado()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.valor is number
        && request.resource.data.valor > 0
        && request.resource.data.formaPagamento in ['Debito', 'Credito', 'Especie', 'Pix']
        && (souGerencial() || (souRecepcaoAtivo() && dentroDoHorarioPermitido()));

      // Edicao e exclusao: o administrador pode sempre, em qualquer dia,
      // periodo e de qualquer atendente (nao ha nenhuma restricao de tempo
      // para ele). O supervisor pode corrigir qualquer lancamento (parte do
      // fechamento), tambem sem restricao de horario, dia ou atendente. A
      // recepcao so pode mexer no proprio lancamento, dentro do horario
      // permitido, e apenas se o lancamento foi criado ha no maximo 3 dias
      // (comparando a DATA local, nao um numero fixo de horas, entao um
      // lancamento de 3 dias atras as 18h continua editavel hoje de manha,
      // do mesmo jeito que um de 3 dias atras as 8h) - isso cobre casos como
      // uma queda de energia que impede fechar os lancamentos no mesmo dia.
      allow update, delete: if souAdmin()
        || souSupervisorAtivo()
        || (
          souRecepcaoAtivo()
          && resource.data.usuarioId == request.auth.uid
          && dentroDoHorarioPermitido()
          && diaLocalDeHoje() - diaLocalDoMomento(resource.data.criadoEm) <= 3
        );
    }

    // ---------- fechamentos (fechamento diario de caixa) ----------
    // Administrador e supervisor acessam (fazem o fechamento consolidado,
    // com despesas e deposito). A recepcao nunca ve isso.
    match /fechamentos/{data} {
      allow read, write: if souGerencial();
    }

    // ---------- auditoria (log de edicao/exclusao de lancamentos) ----------
    // Cada vez que um lancamento e editado ou excluido, a tela grava aqui um
    // registro com quem fez, quando, e o que mudou (valor antes/depois de
    // cada campo) - isso NAO existia antes; agora fica registrado mesmo que
    // o proprio lancamento tenha sido apagado. Qualquer pessoa logada e
    // ativa pode CRIAR um registro (precisa ser criado no exato momento em
    // que ela mesma edita/exclui algo, em nome dela mesma - nunca em nome de
    // outra pessoa). So admin e supervisor podem LER o log (e', junto com o
    // fechamento, informacao gerencial). Ninguem pode editar ou apagar um
    // registro de auditoria depois de criado - e um log, tem que ser
    // imutavel para servir de prova de verdade.
    match /auditoria/{registroId} {
      allow read: if souGerencial();
      allow create: if estaLogado()
        && request.resource.data.usuarioId == request.auth.uid
        && (meuUsuario().ativo == true)
        && request.resource.data.acao in ['editar', 'excluir'];
      allow update, delete: if false;
    }
  }
}
